  "cards": [
    {
      "dot": "cyan",
      "title": "Menus are configuration",
      "items": [
        "Categories, years and document types come from config/categories, cached 30 minutes",
        "A category with no years and no types goes straight to the document list",
        "At most 8 years are offered"
      ]
    },
    {
      "dot": "amber",
      "title": "Steps that get skipped",
      "items": [
        "One company on the phone → no company menu",
        "No sub-type configured → no type menu",
        "At most 7 documents are listed, plus Download All"
      ]
    },
    {
      "dot": "violet",
      "title": "Navigation",
      "items": [
        "Back replays the previous step from session history",
        "0, main_menu and select_category return to categories and keep the client",
        "An unknown pick re-asks the same menu; a session expires after 30 minutes"
      ]
    },
    {
      "dot": "emerald",
      "title": "Delivery",
      "items": [
        "Each document is a signed Storage URL valid for 60 minutes",
        "Every delivery appends to documentAccessLogs",
        "The follow-up button restarts at the category menu"
      ]
    }
  ]
