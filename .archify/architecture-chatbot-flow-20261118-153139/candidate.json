  "cards": [
    {
      "dot": "amber",
      "title": "Intake guardrails",
      "items": [
        "Webhook answers 200 before replying; the work continues in waitUntil",
        "X-Hub-Signature-256 is checked with HMAC-SHA256 before parsing",
        "Message IDs are deduped in memory for 5 minutes",
        "An unregistered phone gets a contact-support reply"
      ]
    },
    {
      "dot": "cyan",
      "title": "Conversation state",
      "items": [
        "Session lives in Firestore at sessions/{phone} and expires after 30 minutes",
        "\"hi\" restarts the menu; step history powers Back and Main Menu",
        "Categories come from config/categories, cached for 30 minutes",
        "Multiple clients: buttons for 2–3, a list for 4+"
      ]
    },
    {
      "dot": "emerald",
      "title": "Document delivery",
      "items": [
        "Category → financial year → document type, or straight to the list",
        "At most 7 documents are listed, plus a Download All row",
        "Storage signed URLs expire after 60 minutes; WhatsApp fetches the file",
        "Every delivered document appends to documentAccessLogs"
      ]
    },
    {
      "dot": "violet",
      "title": "Admin side",
      "items": [
        "Categories, clients and files are managed from /admin",
        "Those writes land in Firestore and Firebase Storage"
      ]
    }
  ]
