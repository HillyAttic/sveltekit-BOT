{
  "name": "jpco-whatsapp-bot-sveltekit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/vite/bin/vite.js dev",
    "build": "vite build",
    "preview": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/vite/bin/vite.js preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^8.0.2",
    "@sveltejs/adapter-vercel": "^7.0.3",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "@vite-pwa/sveltekit": "^2.0.2",
    "autoprefixer": "^10.6.2",
    "fast-check": "^4.10.2",
    "jsdom": "^31.0.1",
    "magicast": "^0.5.5",
    "postcss": "^8.5.33",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.164.0"
  }
}
