# Admin login (copy to .env.local and fill in)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me
JWT_SECRET=any_long_random_string

# WhatsApp Cloud API credentials
WHATSAPP_TOKEN=your_whatsapp_access_token_here
PHONE_NUMBER_ID=your_phone_number_id_here

# Webhook verification token (set this to any secret string)
WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token_here

# App secret for webhook signature validation (from Meta App Dashboard)
APP_SECRET=your_app_secret_here

# Firebase Admin (service account JSON, single line)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Firebase Storage bucket (name kept from the Next.js project for compatibility)
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
